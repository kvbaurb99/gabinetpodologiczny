---
import { Image } from "astro:assets";
import { teamMembers } from "./data/team";
---

<section
  id="team"
  class="w-[90%] md:w-[80%] mx-auto mt-10 md:mt-16 py-20 relative"
>
  <div class="relative z-10">
    <div class="mb-8">
      <h2
        class="text-[#007BA7] text-[1.65rem] md:text-[2.125rem] font-bold mb-4"
      >
        Poznaj nasz zespół
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      {
        teamMembers.map((member) => (
          <div
            class="flex flex-col items-center p-6 xl:p-8 bg-white rounded-2xl shadow-xl hover:shadow-2xl transition-all duration-300 border border-blue-100 w-full transform hover:-translate-y-1"
          >
            <div class="absolute top-0 left-0 w-full h-36 bg-blue-50 rounded-br-3xl -z-10 opacity-70" />
            <div class="relative w-48 h-48 xl:w-56 xl:h-56 mb-6 overflow-hidden rounded-full border-4 border-blue-200 shadow-md">
              <Image
                src={member.imageSrc}
                alt={`${member.name} - ${member.role}`}
                widths={[224, 384]}
                sizes="(max-width: 768px) 100vw, 224px"
                class="object-cover w-full h-full"
                loading="lazy"
              />
            </div>
            <div class="text-center w-full">
              <h3 class="text-xl xl:text-2xl font-bold mb-2 text-[#007BA7]">
                {member.name}
              </h3>
              <p class="text-gray-700 mb-6 text-base md:text-[1.15rem]">
                {member.bio}
              </p>
              <a href="/o-nas" class="font-medium text-[#007BA7] hover:underline">
                Więcej o nas →
              </a>
            </div>
            <div class="mt-4 xl:mt-6 w-32 h-1 bg-gradient-to-r from-blue-300 to-teal-300 rounded-full" />
          </div>
        ))
      }
    </div>
  </div>
</section>
