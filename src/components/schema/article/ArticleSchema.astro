---
import type { Article as SchemaArticle, BreadcrumbList, WithContext } from "schema-dts";

interface Props {
  title: string;
  description: string;
  articleSlug: string;
  imageUrl: string;
  authorName: string;
  organizationName: string;
  organizationLogo: string;
}

const {
  title,
  description,
  articleSlug,
  imageUrl,
  authorName,
  organizationName,
  organizationLogo,
} = Astro.props;

const articleUrl = `https://podologjaworze.pl/blog/${articleSlug}`;

const articleSchema: WithContext<SchemaArticle> = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  url: articleUrl,
  image: imageUrl,
  author: {
    "@type": "Person",
    name: authorName,
    url: "https://podologjaworze.pl",
  },
  publisher: {
    "@type": "Organization",
    name: organizationName,
    logo: {
      "@type": "ImageObject",
      url: organizationLogo,
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": articleUrl,
  },
};

const breadcrumbSchema: WithContext<BreadcrumbList> = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://podologjaworze.pl" },
    { "@type": "ListItem", position: 2, name: "Blog", item: "https://podologjaworze.pl/blog" },
    { "@type": "ListItem", position: 3, name: title, item: articleUrl },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
<script
  type="application/ld+json"
  set:html={JSON.stringify(breadcrumbSchema)}
/>
