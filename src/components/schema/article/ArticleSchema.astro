---
import type { BlogPosting, BreadcrumbList, WithContext } from "schema-dts";
import { toIsoDateTime } from "@/utils/isoDateTime";

interface Props {
  title: string;
  description: string;
  articleSlug: string;
  imageUrl: string;
  datePublished: string;
  dateModified?: string;
  category: string;
  content: string;
  organizationName: string;
}

const {
  title,
  description,
  articleSlug,
  imageUrl,
  datePublished,
  dateModified,
  category,
  content,
  organizationName,
} = Astro.props;

const SITE = "https://podologjaworze.pl";
const articleUrl = `${SITE}/blog/${articleSlug}`;

// Wymuś absolute URL dla obrazów (relative paths w Article schema = nieklikable rich result)
const toAbsolute = (u: string) =>
  u?.startsWith("http") ? u : `${SITE}${u?.startsWith("/") ? u : `/${u}`}`;

const wordCount = content
  .replace(/<[^>]+>/g, " ")
  .split(/\s+/)
  .filter(Boolean).length;

const organization = {
  "@type": "Organization" as const,
  "@id": `${SITE}/#business`,
  name: organizationName,
  url: SITE,
  logo: {
    "@type": "ImageObject" as const,
    url: `${SITE}/favicon.png`,
    width: { "@type": "QuantitativeValue" as const, value: 478 },
    height: { "@type": "QuantitativeValue" as const, value: 479 },
  },
};

const articleSchema: WithContext<BlogPosting> = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${articleUrl}#article`,
  headline: title,
  description,
  url: articleUrl,
  image: {
    "@type": "ImageObject",
    url: toAbsolute(imageUrl),
  },
  datePublished: toIsoDateTime(datePublished),
  dateModified: toIsoDateTime(dateModified ?? datePublished),
  inLanguage: "pl-PL",
  articleSection: category,
  wordCount,
  author: organization,
  publisher: organization,
  isPartOf: {
    "@type": "Blog",
    "@id": `${SITE}/blog#blog`,
    name: "Blog podologiczny – Zdrowe Stopy Jaworze",
    url: `${SITE}/blog`,
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": articleUrl,
  },
};

const breadcrumbSchema: WithContext<BreadcrumbList> = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Strona główna", item: SITE },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE}/blog` },
    { "@type": "ListItem", position: 3, name: title, item: articleUrl },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
<script
  type="application/ld+json"
  set:html={JSON.stringify(breadcrumbSchema)}
/>
