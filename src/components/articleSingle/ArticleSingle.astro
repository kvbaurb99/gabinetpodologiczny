---
interface Props {
  title: string;
  image: string;
  content: string;
  category_slug: string;
  category: string;
  date: string;
  updated?: string;
}

const {
  title,
  image,
  content,
  category,
  category_slug,
  date,
  updated,
} = Astro.props;

const formatDate = (value: string) =>
  new Date(value).toLocaleDateString("pl-PL", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
---

<article class="col-span-12 xl:col-span-8">
  <figure class="h-[220px] xl:h-[480px] relative">
    <img
      src={image}
      alt={title}
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 w-full h-full rounded-xl shadow-md shadow-black/10 object-cover"
    />
    <a href={`/kategorie/${category_slug}`}>
      <span
        class="absolute top-4 left-4 bg-[#007BA7] text-white text-xs font-medium px-3 py-1 rounded-full shadow-sm"
      >
        {category}
      </span>
    </a>
  </figure>
  <h1 class="mt-4 xl:mt-6 text-2xl xl:text-4xl font-bold xl:leading-snug">
    {title}
  </h1>
  <p class="mt-3 text-sm text-[#747474]">
    {
      updated && updated !== date ? (
        <>
          Zaktualizowano: <time datetime={updated}>{formatDate(updated)}</time>
        </>
      ) : (
        <time datetime={date}>{formatDate(date)}</time>
      )
    }
  </p>
  <div data-article-content set:html={content} />
  <div
    class="mt-10 p-6 rounded-xl bg-[#007BA7]/5 border-l-4 border-[#007BA7]"
  >
    <p class="font-semibold text-[#007BA7] text-lg mb-2">
      Gabinet podologiczny w Jaworzu koło Bielska-Białej
    </p>
    <p class="text-[#555] leading-[1.7]">
      Masz podobny problem ze stopami? Umów wizytę w gabinecie Zdrowe Stopy
      przy ul. Zdrojowej 78 w Jaworzu, pod numerem <a
        href="tel:+48501408528"
        class="text-[#007BA7] font-semibold">+48 501 408 528</a
      >.
      <a href="/podolog-bielsko-biala" class="text-[#007BA7] underline">Dojazd z Bielska-Białej</a>.
    </p>
  </div>
</article>
