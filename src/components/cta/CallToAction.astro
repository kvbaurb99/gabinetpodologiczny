---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Umów wizytę w gabinecie w Jaworzu",
  description = "Wizyty umawiamy telefonicznie. Gabinet znajduje się przy ul. Zdrojowej 78 w Jaworzu – kilkanaście minut samochodem z Bielska-Białej.",
} = Astro.props;
---

<section
  class="w-[90%] md:w-[80%] mx-auto mt-10 md:mt-16 p-6 md:p-10 rounded-xl bg-[#007BA7] text-white flex flex-col md:flex-row md:items-center justify-between gap-6"
>
  <div class="max-w-2xl">
    <p class="text-[1.4rem] md:text-[1.75rem] font-bold mb-2">{title}</p>
    <p class="text-white/90 leading-[1.7]">{description}</p>
  </div>
  <div class="flex flex-col gap-3 shrink-0">
    <a
      href="tel:+48501408528"
      class="inline-flex items-center justify-center gap-2 bg-white text-[#007BA7] font-semibold px-6 py-3 rounded-md no-underline transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_5px_15px_rgba(0,0,0,0.2)]"
    >
      <svg width="18" height="18"><use href="#i-phone" /></svg>
      +48 501 408 528
    </a>
    <a
      href="tel:+48509614723"
      class="inline-flex items-center justify-center gap-2 border border-white/40 text-white font-medium px-6 py-3 rounded-md no-underline transition-colors duration-300 hover:bg-white/10"
    >
      <svg width="18" height="18"><use href="#i-phone" /></svg>
      +48 509 614 723
    </a>
  </div>
</section>
