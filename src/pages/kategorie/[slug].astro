---
import MainLayout from "@/layouts/MainLayout.astro";
import ArticleCard from "@/components/blog/card/ArticleCard.astro";
import { getCategories } from "@/server/getCategories";
import { getArticles } from "@/server/getArticles";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/");

let categories = [] as Awaited<ReturnType<typeof getCategories>>;
let articles = [] as Awaited<ReturnType<typeof getArticles>>;
try {
  [categories, articles] = await Promise.all([
    getCategories(),
    getArticles(),
  ]);
} catch {}

const category = categories.find((item) => item.slug === slug);
const filteredArticles = articles.filter(
  (item) => item.category === category?.name
);
---

<MainLayout
  title={`Kategoria ${category?.name ?? ""} - Zdrowe Stopy Podolog Jaworze`}
  description=""
  canonical={`https://podologjaworze.pl/kategorie/${slug}`}
  ogTitle={`Kategoria ${category?.name ?? ""} - Zdrowe Stopy Podolog Jaworze`}
  ogUrl={`https://podologjaworze.pl/kategorie/${slug}`}
>
  <section class="w-[90%] md:w-[80%] mx-auto mt-10 md:mt-16">
    <h1
      class="relative inline-block mb-8 font-bold text-[#007BA7] text-[1.55rem] md:text-[2.125rem]"
    >
      Kategoria {category?.name}
    </h1>
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-4 mt-4">
      {
        filteredArticles.map((article) => (
          <ArticleCard
            title={article.title}
            category={article.category}
            priority
            description={article.overview}
            category_slug={article.category_slug}
            date="12.12.2023"
            alt="test"
            img={article.image}
            slug={article.slug}
          />
        ))
      }
    </div>
  </section>
</MainLayout>
