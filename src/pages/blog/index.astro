---
import MainLayout from "@/layouts/MainLayout.astro";
import ArticleCard from "@/components/blog/card/ArticleCard.astro";
import { getArticles } from "@/server/getArticles";
import TestImage from "@/assets/backgrounds/new_1.webp";
import type { Blog, WithContext } from "schema-dts";

let articles = [] as Awaited<ReturnType<typeof getArticles>>;
try {
  articles = await getArticles();
} catch {
  articles = [];
}

const SITE = "https://podologjaworze.pl";
const blogSchema: WithContext<Blog> = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": `${SITE}/blog#blog`,
  name: "Blog podologiczny – Zdrowe Stopy Jaworze",
  url: `${SITE}/blog`,
  inLanguage: "pl-PL",
  publisher: { "@id": `${SITE}/#business` },
  blogPost: articles.map((article) => ({
    "@type": "BlogPosting",
    "@id": `${SITE}/blog/${article.slug}#article`,
    headline: article.title,
    url: `${SITE}/blog/${article.slug}`,
    datePublished: article.date,
  })),
};
---

<MainLayout
  title="Blog podologiczny – porady podologa z Jaworza | Zdrowe Stopy"
  description="Blog gabinetu Zdrowe Stopy: praktyczna wiedza o leczeniu wrastających paznokci, grzybicy, odcisków i opiece nad stopą cukrzycową. Porady podologa z Jaworza koło Bielska-Białej."
  canonical="https://podologjaworze.pl/blog"
  ogTitle="Blog podologiczny – porady podologa z Jaworza | Zdrowe Stopy"
  ogUrl="https://podologjaworze.pl/blog"
>
  <script
    slot="head-schema"
    type="application/ld+json"
    set:html={JSON.stringify(blogSchema)}
  />
  <section class="w-[90%] md:w-[80%] mx-auto mt-10 md:mt-16">
    <h1
      class="relative inline-block mb-8 font-bold text-[#007BA7] text-[1.55rem] md:text-[2.125rem]"
    >
      Artykuły podologiczne
    </h1>
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-4 mt-4">
      {
        articles.map((article) => (
          <ArticleCard
            title={article.title}
            priority
            category={article.category}
            category_slug={article.category_slug}
            description={article.overview}
            date={article.date}
            alt={article.title}
            img={article.image || TestImage}
            slug={article.slug}
          />
        ))
      }
    </div>
  </section>
</MainLayout>
