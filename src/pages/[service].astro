---
import type { GetStaticPaths } from "astro";
import type { WithContext, Service as SchemaService } from "schema-dts";
import { Image } from "astro:assets";
import MainLayout from "@/layouts/MainLayout.astro";
import Breadcrumbs from "@/components/breadcrumbs/Breadcrumbs.astro";
import Faq from "@/components/sections/faq/Faq.astro";
import CallToAction from "@/components/cta/CallToAction.astro";
import { services, type Service } from "@/data/services";
import { buildFaqSchema } from "@/components/schema/global/faqSchema";
import { areaServed } from "@/components/schema/global/businessSchema";

export const prerender = true;

export const getStaticPaths = (() =>
  services.map((service) => ({
    params: { service: service.slug },
    props: { service },
  }))) satisfies GetStaticPaths;

interface Props {
  service: Service;
}

const { service } = Astro.props;
const SITE = "https://podologjaworze.pl";
const url = `${SITE}/${service.slug}`;
const otherServices = services.filter((s) => s.slug !== service.slug);

const serviceSchema: WithContext<SchemaService> = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${url}#service`,
  name: service.name,
  description: service.metaDescription,
  url,
  serviceType: "Podologia",
  provider: { "@id": `${SITE}/#business` },
  areaServed,
};
---

<MainLayout
  title={service.metaTitle}
  description={service.metaDescription}
  canonical={url}
>
  <script
    slot="head-schema"
    type="application/ld+json"
    set:html={JSON.stringify(serviceSchema)}
  />
  <script
    slot="head-schema"
    type="application/ld+json"
    set:html={JSON.stringify(buildFaqSchema(service.faq, `${url}#faq`))}
  />

  <Breadcrumbs items={[{ name: service.name, path: `/${service.slug}` }]} />

  <section
    class="w-[90%] md:w-[80%] mx-auto mt-6 md:mt-10 flex flex-col md:flex-row md:items-center gap-8"
  >
    <div class="flex-1">
      <h1
        class="text-[#007BA7] text-[1.675rem] md:text-[2.5rem] font-bold mb-4 leading-[1.35]"
      >
        {service.h1}
      </h1>
      <p class="text-[1.1rem] leading-[1.8] text-[#747474] max-w-3xl">
        {service.lead}
      </p>
      <a href="tel:+48501408528" class="inline-block mt-6">
        <button
          class="max-w-fit font-semibold transition-all duration-300 max-md:text-sm bg-[#007BA7] text-white px-6 py-3 rounded-md cursor-pointer hover:bg-[#3b7389] hover:-translate-y-1 hover:shadow-[0_5px_15px_rgba(79,103,189,0.3)]"
        >
          Umów wizytę: +48 501 408 528
        </button>
      </a>
    </div>
    <div
      class="hidden md:flex shrink-0 w-[240px] h-[240px] items-center justify-center bg-[#f9f9f9] rounded-full shadow-[0_4px_12px_rgba(0,0,0,0.08)]"
    >
      <Image
        src={service.image}
        alt=""
        width={140}
        height={160}
        loading="eager"
        class="w-[140px] h-auto"
      />
    </div>
  </section>

  <article class="w-[90%] md:w-[80%] mx-auto mt-10 md:mt-14 max-w-4xl md:ml-[10%]">
    {
      service.sections.map((section) => (
        <section class="mb-10">
          <h2 class="text-[#007BA7] text-[1.4rem] md:text-[1.75rem] font-bold mb-4 leading-[1.35]">
            {section.heading}
          </h2>
          {section.paragraphs.map((paragraph) => (
            <p class="mb-4 text-[1.05rem] leading-[1.8] text-[#555]">
              {paragraph}
            </p>
          ))}
          {section.list && (
            <ul class="list-disc pl-6 flex flex-col gap-2 text-[1.05rem] leading-[1.7] text-[#555]">
              {section.list.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
        </section>
      ))
    }
  </article>

  <Faq items={service.faq} title={`${service.name} – najczęstsze pytania`} />

  <CallToAction />

  <section class="w-[90%] md:w-[80%] mx-auto mt-10 md:mt-16">
    <h2 class="text-[#007BA7] text-[1.4rem] md:text-[1.75rem] font-bold mb-6">
      Inne problemy, którymi się zajmujemy
    </h2>
    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        otherServices.map((other) => (
          <li>
            <a
              href={`/${other.slug}`}
              class="flex items-center justify-between gap-3 p-5 bg-[#f9f9f9] rounded-[10px] shadow-[0_4px_12px_rgba(0,0,0,0.06)] text-[#333] font-medium no-underline transition-all duration-300 hover:text-[#007BA7] hover:-translate-y-1"
            >
              {other.name}
              <span class="text-[#007BA7]" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-[#747474]">
      Przyjeżdżasz z Bielska? Sprawdź, <a
        href="/podolog-bielsko-biala"
        class="text-[#007BA7] underline">jak dojechać do gabinetu z Bielska-Białej</a
      >.
    </p>
  </section>
</MainLayout>
