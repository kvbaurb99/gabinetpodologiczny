---
import MainLayout from "@/layouts/MainLayout.astro";
import Header from "@/components/header/Header";
import AboutsUs from "@/components/sections/aboutUs/AboutsUs.astro";
import Offer from "@/components/sections/offer/Offer.astro";
import Team from "@/components/sections/team/Team.astro";
import Reviews from "@/components/sections/reviews/Reviews";
import Location from "@/components/sections/location/Location.astro";
import BlogSection from "@/components/sections/blog/BlogSection.astro";
import { getArticles } from "@/server/getArticles";
import { getImage } from "astro:assets";
import { headerSlides } from "@/components/header/data/headerSlides";
import Faq from "@/components/sections/faq/Faq.astro";
import { faqSchema, homeFaq } from "@/components/schema/global/faqSchema";

let articles = [] as Awaited<ReturnType<typeof getArticles>>;
try {
  articles = await getArticles();
} catch {
  articles = [];
}

const mapsApiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY ?? "";

const HEADER_WIDTHS = [640, 960, 1280, 1600, 1920, 2560];
const optimizedSlides = await Promise.all(
  headerSlides.map(async (slide) => {
    const img = await getImage({
      src: slide.src,
      widths: HEADER_WIDTHS,
      format: "webp",
    });
    return {
      src: img.src,
      srcSet: img.srcSet.attribute,
      width: img.attributes.width,
      height: img.attributes.height,
      alt: slide.alt,
      title: slide.title,
      description: slide.description,
    };
  })
);

const lcpSlide = optimizedSlides[0];
---

<MainLayout
  title="Podolog Jaworze i Bielsko-Biała | Gabinet Podologiczny Zdrowe Stopy"
  description="Gabinet podologiczny Zdrowe Stopy w Jaworzu, kilkanaście minut od Bielska-Białej. Leczenie wrastających paznokci, grzybicy, odcisków i kurzajek. Zadzwoń i umów wizytę."
  canonical="https://podologjaworze.pl"
>
  <script
    slot="head-schema"
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
  />
  {
    lcpSlide && (
      <link
        slot="head-extra"
        rel="preload"
        as="image"
        href={lcpSlide.src}
        imagesrcset={lcpSlide.srcSet}
        imagesizes="100vw"
        fetchpriority="high"
      />
    )
  }
  <Header slides={optimizedSlides} client:load />
  <AboutsUs
    main
    title="Gabinet podologiczny w Jaworzu – podolog dla Bielska-Białej i okolic"
    description="Witaj w gabinecie podologicznym Zdrowe Stopy przy ul. Zdrojowej 78 w Jaworzu – tuż za granicą Bielska-Białej. Przyjmujemy pacjentów z Jaworza, Bielska-Białej, Jasienicy, Skoczowa i okolicznych miejscowości. Specjalizujemy się w diagnostyce i leczeniu dolegliwości stóp – od profilaktycznej pielęgnacji po leczenie wrastających paznokci, grzybicy i opiekę nad stopą cukrzycową."
  />
  <AboutsUs
    reverse
    title="Zabiegi podologiczne – wrastające paznokcie, odciski, grzybica"
    description="Poszukujesz skutecznego rozwiązania problemów ze stopami? W gabinecie Zdrowe Stopy każdy pacjent otrzymuje kompleksową opiekę i indywidualnie dobrany plan terapii. Leczymy wrastające paznokcie metodami zachowawczymi i klamrami ortonyksyjnymi, usuwamy odciski, modzele i kurzajki oraz prowadzimy bezpieczną pielęgnację stóp osób z cukrzycą."
  />
  <Offer />
  <Team />
  <Reviews client:visible />
  <Faq items={homeFaq} />
  <Location api={mapsApiKey} />
  <BlogSection lazy articles={articles.slice(0, 3)} />
</MainLayout>
